---
import Navigation from '../components/Navigation.jsx';
import Footer from '../components/Footer.jsx';
import ProjectNav from '../components/ProjectNav.jsx';
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Animation | Kassidy Lewis | Graphic Designer</title>
        <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg">
    </head>
    <body id="top" class="font-body text-sm md:text-base">
        <header>
            <nav class="p-6 bg-black" aria-labelledby="site-navigation">
                <Navigation />
            </nav>
        </header>
        <main>
            <section class="pt-6 md:pt-12 pb-12 px-6 md:px-24 xl:px-64">
                <a href="/portfolio/projects/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                    <i class="fa-solid fa-angles-left mr-1 text-xs"></i>Back to Projects
                </a>
                <h1 class="py-4 pb-2 font-display text-6xl xl:text-8xl">Animation</h1>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <video width="100%" controls>
                        <source src="/portfolio/images/illustration/animation_2.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                    <video width="100%" controls>
                        <source src="/portfolio/images/illustration/animation_1.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                    <video width="100%" controls>
                        <source src="/portfolio/images/illustration/animation_3.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                    <img 
                        src="/portfolio/images/illustration/story_1.png" 
                        alt="Six-panel storyboard with a screenshot and description accompanying each panel" 
                        class="w-full object-cover"
                    >
                    <img 
                        src="/portfolio/images/illustration/story_4.png" 
                        alt="Six-panel storyboard with a screenshot and description accompanying each panel" 
                        class="w-full object-cover"
                    >
                    <img 
                        src="/portfolio/images/illustration/story_2.png" 
                        alt="Six-panel storyboard with a screenshot and description accompanying each panel" 
                        class="w-full object-cover"
                    >
                    <img 
                        src="/portfolio/images/illustration/story_3.png" 
                        alt="Six-panel storyboard with a screenshot and description accompanying each panel" 
                        class="w-full object-cover"
                    >
                </div>
            </section>
            <div class="px-6 md:px-24 lg:px-64 xl:px-96">
                <section id="the-method" class="pb-12 border-b-3 border-grey/25">
                    <p class="pb-4">In addition to digital illustration, I have also worked on a variety of animation projects in my own personal time and throughout my academic career (it was my original major, in fact!). Alongside a lifelong appreciation for animated media, I am particularly interested in storyboarding, motion graphics, and video editing.</p>
                    <p>All videos were created in Adobe After Effects.</p>
                </section>
                <nav class="py-12" aria-labelledby="project-navigation">
                    <ProjectNav
                        src_left="/portfolio/images/illustration/personal_33.png"
                        alt_left="Close-up of two anthropormorphic characters smiling"
                        link_left="/portfolio/personal-art/"
                        name_left="Personal Artwork"
                        src_right="/portfolio/images/illustration/commission_3.png"
                        alt_right="A winged character with long violet hair kneeling against an orange background"
                        link_right="/portfolio/commission-work/"
                        name_right="Commission Work"
                    />
                </nav>
            </div>
        </main>
        <footer class="py-12 px-6 md:px-24 lg:px-64 xl:px-96 text-white bg-black">
            <Footer />
        </footer>
        <!-- Scripts -->
        <script src="https://kit.fontawesome.com/f3040639fe.js" crossorigin="anonymous"></script>
        <noscript>Your browser does not support JavaScript!</noscript>
    </body>
</html>