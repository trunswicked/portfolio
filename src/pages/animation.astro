---
import Navigation from '../components/Navigation.jsx';
import Footer from '../components/Footer.jsx';
import ProjectNav from '../components/ProjectNav.jsx';
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Animation | Kassidy Lewis | Graphic Designer</title>
        <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg">
    </head>
    <body id="top" class="font-body text-sm md:text-base">
        <header>
            <Navigation />
        </header>
        <main class="pt-6 md:pt-12 px-6 md:px-24 lg:px-48 2xl:px-96">
            <a href="/portfolio/projects/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                <i class="fa-solid fa-angles-left mr-1 text-xs"></i>Back to Projects
            </a>
            <h1 class="pt-4 font-display text-6xl xl:text-8xl">Animation</h1>
            <div class="py-4 pb-6 border-b-3 border-grey/25">
                <p class="pb-4">In addition to digital illustration, I have also worked on a variety of animation projects in my own personal time and throughout my academic career (it was my original major, in fact!). Alongside a lifelong appreciation for animated media, I am particularly interested in storyboarding, motion graphics, and video editing.</p>
                <p>All videos were composed and edited using Adobe After Effects, whereas illustrations were created in Adobe Photoshop.</p>
            </div>
            <div class="py-6">
                <p class="pb-4"><i>This gallery is a work in progress. Check back soon for updates! (Last updated: 3/31/26)</i></p>
                <video width="100%" controls>
                    <source src="/portfolio/images/illustration/animation_2.mp4" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            </div>
            <ProjectNav
                src_left="/portfolio/images/illustration/personal_33.webp"
                alt_left="Close-up of two anthropormorphic characters smiling"
                link_left="/portfolio/personal-art/"
                name_left="Personal Artwork"
                src_right="/portfolio/images/illustration/commission_3.webp"
                alt_right="A winged character with long violet hair kneeling against an orange background"
                link_right="/portfolio/commission-work/"
                name_right="Commission Work"
            />
        </main>
        <Footer />
        <!-- Scripts -->
        <script src="https://kit.fontawesome.com/f3040639fe.js" crossorigin="anonymous"></script>
        <script src="../main.js"></script>
        <noscript>Your browser does not support JavaScript!</noscript>
    </body>
</html>