---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import img1 from '../../assets/images/illustration/personal_1.webp';
import img2 from '../../assets/images/illustration/personal_45.webp';
import img3 from '../../assets/images/illustration/personal_8.webp';
import img4 from '../../assets/images/illustration/personal_33.webp';
import img5 from '../../assets/images/illustration/personal_17.webp';
import img6 from '../../assets/images/illustration/personal_3.webp';
import img7 from '../../assets/images/illustration/personal_10.webp';
import img8 from '../../assets/images/illustration/personal_38.webp';
import img9 from '../../assets/images/illustration/personal_27.webp';
import img10 from '../../assets/images/illustration/personal_25.webp';
import img11 from '../../assets/images/illustration/personal_34.webp';
---
<BaseLayout pageTitle="Personal Art | Kassidy Lewis | Graphic Designer">
    <section class="py-12 md:pt-12 px-6 md:px-24 lg:px-48 2xl:px-96">
        <a href="/portfolio/projects/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
            <i class="fa-solid fa-angles-left mr-1 text-xs"></i>Back to Projects
        </a>
        <h1 class="py-4 font-display text-6xl xl:text-8xl">Personal Art</h1>
        <p class="pb-4">Below is a collection of original artwork, sketches, and fan art that I've shared to social media throughout 2018 to 2026. These are publically shared in order to connect with fellow creatives and potential clients for paid commissions, but I also enjoy the creation of these personal works in order to improve my skills.</p>
        <p>All illustrations were created in Clip Studio Paint.</p>
    </section>
    <section class="pb-12 px-6 md:px-12 xl:px-64">
        <div class="grid grid-cols-1 md:grid-cols-3 grid-flow-dense gap-4">
            <div class="flex flex-col gap-4">
                <Image
                    src={img1}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img2}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img3}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
            </div>
            <div class="flex flex-col gap-4">
                <Image
                    src={img4}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img5}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img6}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img7}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
            </div>
            <div class="flex flex-col gap-4">
                <Image
                    src={img9}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img10}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img11}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img8}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
            </div>
        </div>
    </section>
</BaseLayout>