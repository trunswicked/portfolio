---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import img1 from '../../assets/images/illustration/commission_3.webp';
import img2 from '../../assets/images/illustration/personal_41.webp';
import img3 from '../../assets/images/illustration/commission_22.webp';
import img4 from '../../assets/images/illustration/commission_5.webp';
import img5 from '../../assets/images/illustration/commission_19.webp';
import img6 from '../../assets/images/illustration/commission_23.webp';
import img7 from '../../assets/images/illustration/commission_16.webp';
import img8 from '../../assets/images/illustration/commission_15.webp';
import img9 from '../../assets/images/illustration/commission_10.webp';
import img10 from '../../assets/images/illustration/personal_2.webp';
import img11 from '../../assets/images/illustration/personal_5.webp';
import img12 from '../../assets/images/illustration/commission_1.webp';
import img13 from '../../assets/images/illustration/commission_2.webp';
import img14 from '../../assets/images/illustration/commission_14.webp';
---
<BaseLayout pageTitle="Commission Work | Kassidy Lewis | Graphic Designer">
    <section class="py-12 md:pt-12 px-6 md:px-24 lg:px-48 2xl:px-96">
        <a href="/portfolio/projects/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
            <i class="fa-solid fa-angles-left mr-1 text-xs"></i>Back to Projects
        </a>
        <h1 class="py-4 font-display text-6xl xl:text-8xl">Commission Work</h1>
        <p class="pb-4">Below is a collection of custom illustrations I've completed throughout 2018 to 2026, following the guidelines of clients whom I've connected with via social media or email.</p>
        <p>Clip Studio Paint is my illustration tool of choice, whereas Adobe Illustrator is used for vector projects.</p>
    </section>
    <section class="pb-12 px-6 md:px-12 xl:px-64">
        <div class="grid grid-cols-1 md:grid-cols-3 grid-flow-dense gap-4">
            <div class="flex flex-col gap-4">
                <Image
                    src={img1}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img2}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img3}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img4}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
            </div>
            <div class="flex flex-col gap-4">
                <Image
                    src={img5}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img6}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img7}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img8}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img9}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
            </div>
            <div class="flex flex-col gap-4">
                <Image
                    src={img10}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img11}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img12}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img13}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
                <Image
                    src={img14}
                    alt=" "
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
            </div>
        </div>
    </section>
</BaseLayout>