---
import Navigation from '../components/Navigation.jsx';
import Footer from '../components/Footer.jsx';
import ProjectNav from '../components/ProjectNav.jsx';
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Personal Artwork | Kassidy Lewis | Graphic Designer</title>
        <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg">
    </head>
    <body id="top" class="font-body text-sm md:text-base">
        <header>
            <Navigation />
        </header>
        <main>
            <div class="pt-6 md:pt-12 px-6 md:px-24 lg:px-48 2xl:px-96">
                <a href="/portfolio/projects/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                    <i class="fa-solid fa-angles-left mr-1 text-xs"></i>Back to Projects
                </a>
                <h1 class="pt-4 font-display text-6xl xl:text-8xl">Personal Art</h1>
                <div class="py-4 pb-6 border-b-3 border-grey/25">
                    <p class="pb-4">Below is a collection of original artwork, sketches, and fan art that I've shared to social media throughout 2018 to 2026. These are publically shared in order to connect with fellow creatives and potential clients for paid commissions, but I also enjoy the creation of these personal works in order to improve my skills.</p>
                    <p>All illustrations were created in Clip Studio Paint.</p>
                </div>
            </div>
            <div class="py-6 px-6 md:px-12 xl:px-64 grid grid-cols-1 md:grid-cols-3 grid-flow-dense gap-4">
                <div class="flex flex-col gap-4">
                    <img 
                        src="/portfolio/images/illustration/personal_1.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                    <img 
                        src="/portfolio/images/illustration/personal_45.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                    <img 
                        src="/portfolio/images/illustration/personal_8.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                </div>
                <div class="flex flex-col gap-4">
                    <img 
                        src="/portfolio/images/illustration/personal_33.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                    <img 
                        src="/portfolio/images/illustration/personal_17.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                    <img 
                        src="/portfolio/images/illustration/personal_3.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                    <img 
                        src="/portfolio/images/illustration/personal_10.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                    <img 
                        src="/portfolio/images/illustration/personal_38.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                </div>
                <div class="flex flex-col gap-4">
                    <img 
                        src="/portfolio/images/illustration/personal_27.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                    <img 
                        src="/portfolio/images/illustration/personal_25.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                    <img 
                        src="/portfolio/images/illustration/personal_1.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                    <img 
                        src="/portfolio/images/illustration/personal_34.webp" 
                        alt=" " 
                        class="w-full object-cover rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                    >
                </div>
            </div>
            <div class="px-6 md:px-24 lg:px-48 2xl:px-96">
                <ProjectNav
                    src_left="/portfolio/images/illustration/commission_3.webp"
                    alt_left="A winged character with long violet hair kneeling against an orange background"
                    link_left="/portfolio/commission-work/"
                    name_left="Commission Work"
                    src_right="/portfolio/images/illustration/animation_still.webp"
                    alt_right="Video still with the caption: How To Comic Page"
                    link_right="/portfolio/animation/"
                    name_right="Animation"
                />
            </div>
        </main>
        <Footer />
        <!-- Scripts -->
        <script src="https://kit.fontawesome.com/f3040639fe.js" crossorigin="anonymous"></script>
        <script src="../main.js"></script>
        <noscript>Your browser does not support JavaScript!</noscript>
    </body>
</html>