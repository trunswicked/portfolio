---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhyMe from '../components/WhyMe.astro';
---
<BaseLayout pageTitle="Contact Me | Kassidy Lewis | Graphic Designer">
    <div class="py-12 md:pt-12 px-6 md:px-24 lg:px-48 2xl:px-96">
        <h1 class="font-display text-6xl xl:text-8xl">Contact Me</h1>
        <div class="pt-4">
            <p>
                Got a project idea, or looking to hire an up-and-coming graphic and web designer? I'd love to work with you! Get in touch, or drop a hello at:
            </p>
            <p class="py-4">
                <a href="mailto:trunswickedart@gmail.com" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                    <i class="fa-solid fa-envelope mr-1"></i>trunswickedart@gmail.com
                </a>
            </p>
            <p>
                Additionally, you may find me on <a href="https://www.linkedin.com/in/kassidy-lewis/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300"><i class="fa-brands fa-linkedin mr-1"></i>LinkedIn</a> or <a href="https://github.com/trunswicked/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300"><i class="fa-brands fa-github mr-1"></i>GitHub</a>. I'm always willing to connect with clients and fellow creatives.
            </p>
        </div>
        <WhyMe />
    </div>
</BaseLayout>