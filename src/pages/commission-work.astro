---
import Navigation from '../components/Navigation.jsx';
import Footer from '../components/Footer.jsx';
import ProjectNav from '../components/ProjectNav.jsx';
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Commission Work | Kassidy Lewis | Graphic Designer</title>
        <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg">
    </head>
    <body id="top" class="font-body text-sm md:text-base">
        <header>
            <nav class="p-6 bg-black" aria-labelledby="site-navigation">
                <Navigation />
            </nav>
        </header>
        <main>
            <section class="pt-6 md:pt-12 pb-12 px-6 md:px-24 xl:px-64">
                <a href="/portfolio/projects/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                    <i class="fa-solid fa-angles-left mr-1 text-xs"></i>Back to Projects
                </a>
                <h1 class="py-4 pb-2 font-display text-6xl xl:text-8xl">Commission Work</h1>
                <div class="grid grid-cols-1 md:grid-cols-3 grid-flow-dense gap-4">
                    <div class="flex flex-col gap-4">
                        <img 
                            src="/portfolio/images/illustration/commission_3.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/personal_41.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/commission_22.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/commission_5.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                    </div>
                    <div class="flex flex-col gap-4">
                        <img 
                            src="/portfolio/images/illustration/commission_19.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/commission_23.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/commission_16.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/commission_15.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/commission_10.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                    </div>
                    <div class="flex flex-col gap-4">
                        <img 
                            src="/portfolio/images/illustration/personal_2.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/personal_5.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/commission_1.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/commission_2.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                        <img 
                            src="/portfolio/images/illustration/commission_14.webp" 
                            alt=" " 
                            class="w-full object-cover bg-grey/25"
                        >
                    </div>
                </div>
            </section>
            <div class="px-6 md:px-24 lg:px-48 xl:px-96">
                <section class="pb-12 border-b-3 border-grey/25">
                    <p>Above is a collection of custom illustrations I've completed throughout 2018 to 2026, following the guidelines of clients whom I've connected with via social media or email.</p>
                    <p class="py-4">While the majority of commission requests I receive involve character artwork - including original characters and fan art - I have also assisted clients in designing individual elements such as logos, objects, weapons, and outfits.</p>
                    <p>Clip Studio Paint is my illustration tool of choice, whereas Adobe Illustrator is used for vector projects.</p>
                </section>
                <nav class="py-12" aria-labelledby="project-navigation">
                    <ProjectNav
                        src_left="/portfolio/images/illustration/animation_still.webp"
                        alt_left="Video still with the caption: How To Comic Page"
                        link_left="/portfolio/animation/"
                        name_left="Animation"
                        src_right="/portfolio/images/illustration/personal_33.webp"
                        alt_right="Close-up of two anthropormorphic characters smiling"
                        link_right="/portfolio/personal-art/"
                        name_right="Personal Artwork"
                    />
                </nav>
            </div>
        </main>
        <Footer />
        <!-- Scripts -->
        <script src="https://kit.fontawesome.com/f3040639fe.js" crossorigin="anonymous"></script>
        <script src="../main.js"></script>
        <noscript>Your browser does not support JavaScript!</noscript>
    </body>
</html>