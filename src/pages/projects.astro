---
import Navigation from '../components/Navigation.jsx';
import Footer from '../components/Footer.jsx';
import ProjectItem from '../components/ProjectItem.jsx';
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Projects | Kassidy Lewis | Graphic Designer</title>
        <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg">
    </head>
    <body id="top" class="font-body text-sm md:text-base">
        <header>
            <nav class="p-6 bg-black">
                <Navigation />
            </nav>
        </header>
        <main>
            <section class="py-12 md:pt-12 px-6 md:px-24 lg:px-48 xl:px-96">
                <h1 class="font-display text-6xl xl:text-8xl">Projects</h1>
                <p class="pt-4 pb-6 border-b-3 border-grey/25">Displayed throughout this site is a selection of projects that I feel best showcase my skills in web development, illustration, and graphic design. Each has its own individual project page detailing its objective, process, and final images.</p>
                <h3 class="pt-12 pb-1 font-display text-2xl">
                    <i class="fa-solid fa-crop-simple opacity-25"></i>
                    Graphic Design, Web Development
                </h3>
                <em>Hover or tap images to view project details</em>
                <div class="py-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <ProjectItem
                            src="/portfolio/images/design/portfolio_home.webp"
                            alt="Mobile and desktop versions of a portfolio website shown side-by-side"
                            url="/portfolio/portfolio-site/"
                            title="Portfolio Site"
                            desc="2025 to 2026, Web Development"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Portfolio Site</strong> | 2025 to present</span>
                        </div>
                    </div>
                    <div>
                        <ProjectItem
                            src="/portfolio/images/design/fairchild_home.webp"
                            alt="Mobile and desktop versions of a website homepage shown side-by-side"
                            url="/portfolio/fairchild-website/"
                            title="Fairchild Website"
                            desc="2026, Web Development"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Fairchild Website</strong> | 2026</span>
                        </div>
                    </div>
                    <div>
                        <ProjectItem
                            src="/portfolio/images/design/mockup_desktop.webp"
                            alt="Webpage mockup shown on two desktop monitors"
                            url="/portfolio/page-mockup/"
                            title="Page Mockup"
                            desc="2024, Web Development"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Page Mockup</strong> | 2024</span>
                        </div>
                    </div>
                    <div>
                        <ProjectItem
                            src="/portfolio/images/design/alesco_overview.webp"
                            alt="Logo designs for Alesco Design Solutions"
                            url="/portfolio/logo-work/"
                            title="Logo Work"
                            desc="2024 to present, Graphic Design"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Logo Work</strong> | 2024 to present</span>
                        </div>
                    </div>
                    <div>
                        <ProjectItem
                            src="/portfolio/images/design/socmed_comms.webp"
                            alt="Two social media graphics titled: Commission Prices"
                            url="/portfolio/social-media-graphics/"
                            title="Social Media Graphics"
                            desc="2018 to present, Graphic Design"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Social Media Graphics</strong> | 2018 to present</span>
                        </div>
                    </div>
                    <div>
                        <ProjectItem
                            src="/portfolio/images/design/map_overview.webp"
                            alt="Screenshot of an interactive fantasy map"
                            url="/portfolio/interactive-map/"
                            title="Interactive Map"
                            desc="2024, Web Development"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Interactive Map</strong> | 2024 to 2026</span>
                        </div>
                    </div>
                    <div>
                        <ProjectItem
                            src="/portfolio/images/design/clock_entrance.webp"
                            alt="Screenshot of a building entrance in a 3D environment"
                            url="/portfolio/clock-exhibit/"
                            title="Clock Exhibit"
                            desc="2024, Multimedia"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Clock Exhibit</strong> | 2024</span>
                        </div>
                    </div>
                </div>
                <h3 class="pt-6 font-display text-2xl">
                    <i class="fa-solid fa-palette opacity-25"></i>
                    Illustration, Animation
                </h3>
                <em>Hover or tap images to view project details</em>
                <div class="py-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <ProjectItem
                            src="/portfolio/images/illustration/commission_3.webp"
                            alt="A winged character with long violet hair kneeling against an orange background"
                            url="/portfolio/commission-work/"
                            title="Commission Work"
                            desc="2018 to present, character artwork"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Commission Work</strong> | 2018 to present</span>
                        </div>
                    </div>
                    <div>
                        <ProjectItem
                            src="/portfolio/images/illustration/personal_33.webp"
                            alt="Close-up of two anthropormorphic characters smiling"
                            url="/portfolio/personal-art/"
                            title="Personal Artwork"
                            desc="2018 to present, fan art and sketches"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Personal Artwork</strong> | 2018 to present</span>
                        </div>
                    </div>
                    <div>
                        <ProjectItem
                            src="/portfolio/images/illustration/animation_still.webp"
                            alt="Video still with the caption: How To Comic Page"
                            url="/portfolio/animation/"
                            title="Animation"
                            desc="2018 to present, Motion Graphics & Storyboarding"
                        />
                        <div class="pt-2 lg:hidden">
                            <span><strong>Animation</strong> | 2018 to present</span>
                        </div>
                    </div>
                </div>
            </section>
        </main>
        <Footer />
        <!-- Scripts -->
        <script src="https://kit.fontawesome.com/f3040639fe.js" crossorigin="anonymous"></script>
        <noscript>Your browser does not support JavaScript!</noscript>
    </body>
</html>