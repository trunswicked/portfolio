---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../layouts/ProjectGrid.astro';
---
<BaseLayout pageTitle="Projects | Kassidy Lewis | Graphic Designer">
    <section class="py-12 md:pt-12 px-6 md:px-24 lg:px-48 2xl:px-96">
        <h1 class="font-display text-6xl xl:text-8xl">Projects</h1>
        <p class="py-4 pb-6">Displayed throughout this site is a selection of projects that I feel best showcase my skills in web development, illustration, and graphic design. Each has its own individual project page detailing its objective, process, and final images; navigate these pages using the links below!</p>
        <ProjectGrid />
    </section>
</BaseLayout>