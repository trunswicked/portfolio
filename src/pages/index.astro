---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../layouts/ProjectGrid.astro';
---
<BaseLayout pageTitle="Home | Kassidy Lewis | Graphic Designer">
    <section class="px-6 md:px-12 py-12 min-h-[calc(100svh-68px)] md:min-h-[calc(100svh-72px)] flex flex-col items-center text-center overflow-hidden bg-teal">
        <div class="grow flex flex-wrap justify-center content-center">
            <h1 class="pb-2 w-full font-display font-bold text-6xl md:text-8xl uppercase">
                Kassidy Lewis
            </h1>
            <span class="font-display text-2xl md:text-4xl">
                Designer | Illustrator | Developer
            </span>
        </div>
        <em class="animate-bounce">
            Scroll to continue <i class="fa-solid fa-angles-down text-xs"></i>
        </em>
    </section>
    <div class="px-6 md:px-24 lg:px-48 2xl:px-96">
        <section class="py-12">
            <div class="p-6 rounded bg-grey/10 border-2 border-grey/25">
                <h2 class="font-display text-4xl">The Artist</h2>
                <p class="py-4">Kassidy is an illustrator, designer, and ASU alumni with a love for colorful characters and the natural environment. When she's not seated at her work desk, she's always searching for something new to spark her creativity.</p>
                <a href="/portfolio/about/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                    More about Kassidy<i class="fa-solid fa-angles-right ml-1 text-xs"></i>
                </a>
            </div>
        </section>
        <section class="pb-12">
            <div class="pb-2">
                <h2 class="font-display text-4xl">The Work</h2>
                <div class="bg-teal/25 h-5 -mt-4"></div>
            </div>
            <ProjectGrid />
        </section>
    </div>
</BaseLayout>