---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SubNavigation from '../components/SubNavigation.astro';
import SkillBox from '../components/SkillBox.astro';
import WhyMe from '../components/WhyMe.astro';
import portraitImg from '../assets/images/portrait.webp';
import clockImg from '../assets/images/design/clock_entrance.webp';
import commImg from '../assets/images/illustration/commission_3.webp';
---
<BaseLayout pageTitle="About Me | Kassidy Lewis | Graphic Designer">
    <section class="pt-6 md:pt-12 pb-12 px-6 md:px-12 xl:px-64">
        <div class="grid gap-6">
            <div class="
                row-[1/2] col-[1/2]
                lg:row-[1/3] lg:col-[1/2] min-w-50
            ">
                <Image 
                    src={portraitImg}
                    alt="Black-and-white portrait of Kassidy Lewis"
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity img-expand"
                />
            </div>
            <div class="
                row-[2/3] col-[1/3]
                lg:row-[1/2] lg:col-[2/3]
                lg:self-end
            ">
                <h1 class="pt-2 font-display text-6xl xl:text-8xl">About Me</h1>
                <p class="pt-4">Hi there! I'm Kassidy, a designer, developer, and ASU alumni with a love for colorful characters and the natural environment. When I'm not seated at my work desk, I'm always searching for something new to spark my creativity. Other passions of mine include digital painting, zoology and wildlife education, playing role-playing games for hours on end, and creating my own original worlds.</p>
                <p class="py-4">I've also worked with dozens of partners from 2018 to the present day, which includes individual clients as well as local businesses within Arizona. My ultimate goal is to provide the tools entrepreneurs need to market themselves, and to deliver creative works to be enjoyed for years to come.</p>
                <a href="../assets/kassidy_lewis_resume.pdf" target="_blank" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                    <i class="fa-solid fa-file-lines"></i><i class="fa-solid fa-download mr-1"></i>Download my résumé (opens in new tab)
                </a>
            </div>
            <div class="-ml-36 mb-6 lg:mb-0 h-25 self-end lg:self-start rounded bg-teal mix-blend-exclusion"></div>
        </div>
    </section>
    <SubNavigation
        linkOne="#skills"
        labelOne="Skills"
        linkTwo="#education"
        labelTwo="Education"
        linkThree="#work-experience"
        labelThree="Work Experience"
    />
    <div class="py-12 px-6 md:px-24 lg:px-48 2xl:px-96">
        <section class="pb-12 border-b-3 border-grey/25">
            <div class="pb-2">
                <h2 id="skills" class="font-display text-4xl">Skills</h2>
                <div class="bg-teal/25 h-5 -mt-5"></div>
            </div>
            <h3 class="pt-4 font-display text-2xl">Tools of the Trade</h3>
            <div class="pt-2 grid grid-cols-2 lg:grid-cols-3 gap-4">
                <SkillBox
                    icon="../assets/images/svg/icon-vsc.svg"
                    alt="Logo of Visual Studio Code"
                    tool="Visual Studio Code"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-figma.svg"
                    alt="Logo of Figma"
                    tool="Figma"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-xd.svg"
                    alt="Logo of Adobe XD"
                    tool="Adobe XD"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-illustrator.svg"
                    alt="Logo of Adobe Illustrator"
                    tool="Illustrator"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-indesign.svg"
                    alt="Logo of Adobe InDesign"
                    tool="InDesign"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-ae.svg"
                    alt="Logo of Adobe After Effects"
                    tool="After Effects"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-photoshop.svg"
                    alt="Logo of Adobe Photoshop"
                    tool="Photoshop"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-csp.svg"
                    alt="Logo of Clip Studio Paint"
                    tool="Clip Studio Paint"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-wp.svg"
                    alt="Logo of WordPress"
                    tool="WordPress"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-blender.svg"
                    alt="Logo of Blender"
                    tool="Blender"
                    progress="w-[25%]"
                    exp="Learning"
                />
            </div>
            <h3 class="pt-6 font-display text-2xl">Specialties</h3>
            <div class="pt-2 grid grid-cols-2 lg:grid-cols-3 gap-4">
                <SkillBox
                    icon="../assets/images/svg/icon-html.svg"
                    alt="Logo of HTML5"
                    tool="HTML / CSS (Vanilla)"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-sass.svg"
                    alt="Logo of Sass"
                    tool="Sass (CSS)"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-bootstrap.svg"
                    alt="Logo of Bootstrap"
                    tool="Bootstrap (CSS)"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-tailwind.svg"
                    alt="Logo of Tailwind CSS"
                    tool="Tailwind (CSS)"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-js.svg"
                    alt="Logo of JavaScript"
                    tool="JavaScript (Vanilla)"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-jquery.svg"
                    alt="Logo of jQuery"
                    tool="jQuery"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-react.svg"
                    alt="Logo of React"
                    tool="React (JS)"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-astro.svg"
                    alt="Logo of Astro JS"
                    tool="Astro (JS)"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-sql.svg"
                    alt="Logo of SQL"
                    tool="SQL"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-code.svg"
                    alt="Wireframe icon"
                    tool="Responsive design"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-code.svg"
                    alt="Wireframe icon"
                    tool="Wireframing"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-brush.svg"
                    alt="Paintbrush icon"
                    tool="Concept sketching"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-brush.svg"
                    alt="Paintbrush icon"
                    tool="Digital illustration"
                    progress="w-[95%]"
                    exp="Expert"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-brush.svg"
                    alt="Paintbrush icon"
                    tool="Branding & identity"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-film.svg"
                    alt="Film icon"
                    tool="Storyboarding"
                    progress="w-[75%]"
                    exp="Proficient"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-film.svg"
                    alt="Film icon"
                    tool="Motion graphics"
                    progress="w-[50%]"
                    exp="Capable"
                />
                <SkillBox
                    icon="../assets/images/svg/icon-film.svg"
                    alt="Film icon"
                    tool="Video editing"
                    progress="w-[50%]"
                    exp="Capable"
                />
            </div>
        </section>
        <section class="py-12 border-b-3 border-grey/25">
            <div class="pb-2">
                <h2 id="education" class="font-display text-4xl">Education</h2>
                <div class="bg-teal/25 h-5 -mt-5"></div>
            </div>
            <h3 class="pt-4 pb-2 font-display text-2xl">
                <i class="fa-solid fa-graduation-cap opacity-25"></i> Arizona State University
            </h3>
            <p class="pb-2">
                <span class="font-semibold">B.S. in Graphic Design</span> / 2020 to 2025, graduated May 2025
            </p>
            <p>I am an alumni of The Design School within the Herberger Institute for Design and the Arts. As an upperclassman, I was enrolled in courses such as Technology for Design, Motion Graphics / Interaction Design, and Regenerative Graphic Design.</p>
            <div class="py-4">
                <a href="/portfolio/projects/clock-exhibit/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                    View my Clock Exhibit project<i class="fa-solid fa-angles-right ml-1 text-xs"></i>
                </a>
            </div>
            <a href="/portfolio/projects/clock-exhibit/">
                <Image 
                    src={clockImg}
                    alt="Screenshot of a building entrance in a 3D environment"
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity"
                />
            </a>
            <h3 class="pt-6 pb-2 font-display text-2xl">
                <i class="fa-solid fa-graduation-cap opacity-25"></i> Huntington University Arizona
            </h3>
            <p>
                <span class="font-semibold">B.S. in Animation</span> / 2018 to 2020, transferred to Arizona State University
            </p>
            <p class="pt-2">Before ultimately deciding to transfer to Arizona State University, I completed undergraduate courses such as 3D Computer Graphics I, Storyboard and Concept, and Web Design at HUAZ.</p>
        </section>
        <section class="pt-12">
            <div class="pb-2">
                <h2 id="work-experience" class="font-display text-4xl">Work Experience</h2>
                <div class="bg-teal/25 h-5 -mt-5"></div>
            </div>
            <h3 class="pt-4 pb-2 font-display text-2xl">
                <i class="fa-solid fa-palette opacity-25"></i> Freelance Designer
            </h3>
            <p class="pb-2">
                <span class="font-semibold">Self-employed</span> / 2018 to present
            </p>
            <p>Currently, I manage a wide variety of projects involving digital illustration, website design, and the creation of assets such as logos, among other tasks. I have worked with individual clients as well as local businesses within Arizona, such as Alesco Design Solutions. My responsibilities include completing thumbnail sketches and wireframes, presenting a design brief, and communicating with clients across multiple revision stages.</p>
            <p class="py-4">
                <a href="/portfolio/projects/commission-work/" class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                    View my commission work<i class="fa-solid fa-angles-right ml-1 text-xs"></i>
                </a>
            </p>
            <a href="/portfolio/projects/commission-work/">
                <Image 
                    src={commImg}
                    alt="A winged character with long violet hair kneeling against an orange background"
                    class="rounded bg-grey/25 hover:opacity-75 transition-opacity"
                />
            </a>
            <h3 class="pt-6 pb-1 font-display text-2xl">
                <i class="fa-solid fa-box-archive opacity-25"></i> Package Handler
            </h3>
            <p class="pb-2">
                <span class="font-semibold">Atomic Ammunition</span> / Phoenix, AZ, 2020
            </p>
            <p>I was responsible for labelling and sorting packages in a warehouse environment. Additionally, I participated in loading packages onto palettes alongside other workers, and assisted in daily work area maintenance.</p>
        </section>
        <WhyMe />
    </div>
</BaseLayout>