---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const { icon, alt, tool, progress, exp } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/svg/*.svg');
if (!images[icon]) throw new Error(`"${icon}" does not exist in glob."`);
---
<div> 
    <div class="p-4 h-15 flex items-center rounded-t border-t-2 border-x-2 border-grey/25 bg-grey/10">
        <Image 
            src={images[icon]()} 
            alt={alt} 
            class="w-5 h-5"
        />
        <span class="ml-3">{tool}</span>
    </div>
    <div class="mb-1 h-2 w-full bg-black">
        <div class={`h-2 ${progress} bg-teal`}></div>
    </div>
    <span>Experience: {exp}</span>
</div>