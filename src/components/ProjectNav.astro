---
import { Image } from 'astro:assets';
import portfolioImg from '../assets/images/design/portfolio_home.webp';
---
<nav class="py-12 border-t-3 border-grey/25" aria-labelledby="project-navigation">
    <div class="flex justify-between">
        <div>
            <a href={project.link}>
                <div class="w-30 md:w-50 rounded">
                    <Image 
                        src={portfolioImg} 
                        alt={project.alt} 
                        class="h-20 md:h-30 object-cover rounded bg-grey/25 mb-2 hover:opacity-75 transition-opacity"
                    />
                </div>
            </a>
            <a href={project.link} class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                <i class="fa-solid fa-angles-left mr-1 text-xs"></i>{project.name}
            </a>
        </div>
        <div class="text-right">
            <a href=" ">
                <div class="ml-auto w-30 md:w-50 rounded bg-grey/25">
                    <img src=" " alt=" " class="h-20 md:h-30 object-cover rounded mb-2 hover:opacity-75 transition-opacity"></img>
                </div>
            </a>
            <a href=" " class="font-semibold hover:text-teal hover:underline decoration-2 underline-offset-3 transition-all duration-300">
                "name_right"<i class="fa-solid fa-angles-right ml-1 text-xs"></i>
            </a>
        </div>
    </div>
</nav>